# systemd unit for our relay (M7). install.sh copies it to
# /etc/systemd/system/iroh-relay.service.
[Unit]
Description=Couch Co-App relay (iroh-relay)
Documentation=https://github.com/n0-computer/iroh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/iroh-relay.toml
# IROH_RELAY_ACCESS_TOKEN=<release.toml's relay_token>; root-owned, mode 600.
EnvironmentFile=/etc/iroh-relay/token.env
Environment=RUST_LOG=info
Restart=always
RestartSec=5

# Its own unprivileged user; ports 80 and 443 through the one capability.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Let's Encrypt's account and certificates (cert_dir).
StateDirectory=iroh-relay
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
